<Window x:Class="OAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OAI.ViewModels"
        xmlns:views="clr-namespace:OAI.Views"
        Title="OAI"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Language="ar-SA"
        FontFamily="Segoe UI, Cairo, Tahoma"
        Background="{StaticResource BrushApp}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SourcesAndRulesViewModel}">
            <views:SourcesAndRulesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
            <views:SetupWizardView/>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushSidebar}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    FlowDirection="LeftToRight">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource BrushAccent}" Margin="0,0,8,0">
                            <TextBlock Text="OAI" Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="مطابقة التوظيف الذكي" Foreground="{StaticResource BrushText}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   FlowDirection="RightToLeft"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Content="—" Click="MinimizeButton_Click" ToolTip="تصغير"/>
                        <Button Style="{StaticResource ChromeButton}" Content="[]" Click="MaximizeButton_Click" ToolTip="تكبير"/>
                        <Button Style="{StaticResource CloseChromeButton}" Content="X" Click="CloseButton_Click" ToolTip="إغلاق"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="200"
                        Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BrushSidebar}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                    <Grid Margin="10,16,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <RadioButton Style="{StaticResource NavItem}"
                                         Content="لوحة المتابعة"
                                         GroupName="Nav"
                                         IsChecked="{Binding IsDashboard, Mode=TwoWay}"
                                         Command="{Binding NavigateDashboardCommand}"/>
                            <RadioButton Style="{StaticResource NavItem}"
                                         Content="المصادر والملف"
                                         GroupName="Nav"
                                         IsChecked="{Binding IsSources, Mode=TwoWay}"
                                         Command="{Binding NavigateSourcesAndRulesCommand}"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="LocalDB" Foreground="{StaticResource BrushText}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="متصل" Foreground="#4ADE80" FontSize="11" Margin="0,4,0,8"/>
                                <TextBlock Text="إيقاف قبل الإرسال مفعّل" Foreground="{StaticResource BrushWarning}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource BrushSidebar}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock Text="جاهز  ·  v1.0" Foreground="{StaticResource BrushMuted}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Text="تطوير أسامة المشرقي" Foreground="{StaticResource BrushMuted}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="2026" Foreground="{StaticResource BrushMuted}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
