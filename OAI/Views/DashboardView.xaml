<UserControl x:Class="OAI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Language="ar-SA"
             FontFamily="Segoe UI, Cairo, Tahoma"
             Background="{StaticResource BrushApp}">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="لوحة المتابعة" Style="{StaticResource CaptionText}"/>
                <TextBlock Text="الوظائف، المطابقة، والتعبئة التلقائية قبل الإرسال" Style="{StaticResource SubtitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="بحث في المصادر" Command="{Binding DiscoverJobsCommand}"
                        Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="مكتشفة" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding TotalJobsFound}" Foreground="#60A5FA" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="جاهزة للمراجعة" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding TotalAppliedHardStop}" Foreground="#FBBF24" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="مقابلات" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding InterviewsCount}" Foreground="#4ADE80" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="قيد التحليل" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding PendingReviewCount}" Foreground="#F472B6" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel ItemHeight="34">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                            <TextBlock Text="من" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                            <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="الحالة" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}">
                                <ComboBoxItem Content="الكل"/>
                                <ComboBoxItem Content="جاهز للمراجعة (Hard Stop)"/>
                                <ComboBoxItem Content="تم التقديم"/>
                                <ComboBoxItem Content="مقابلات"/>
                                <ComboBoxItem Content="وظائف مكتشفة"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredApplications}"
                              SelectedItem="{Binding SelectedApplication, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المسمى" Binding="{Binding JobTitle}" Width="1.5*"/>
                            <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="90"/>
                            <DataGridTextColumn Header="الراتب" Binding="{Binding Salary}" Width="90"/>
                            <DataGridTextColumn Header="التقييم" Binding="{Binding MatchScore, StringFormat={}{0:F0}%}" Width="70"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="بريد التقديم" Binding="{Binding HrEmail}" Width="120"/>
                            <DataGridTemplateColumn Header="" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تقديم"
                                                Style="{StaticResource AppButton}"
                                                Padding="10,4"
                                                FontSize="11"
                                                MinHeight="28"
                                                Command="{Binding DataContext.ResumeApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="تحليل المطابقة" Style="{StaticResource CaptionText}" FontSize="14"/>

                    <Border Grid.Row="1" Background="{StaticResource BrushInput}" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding CopilotSkillGapAnalysis}"
                                       Foreground="{StaticResource BrushText}"
                                       FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="3" Text="رسالة التواصل" Style="{StaticResource FieldLabel}"/>

                    <Border Grid.Row="4" Background="{StaticResource BrushInput}" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding CopilotColdOutreachMessage}"
                                     Style="{StaticResource AppTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MinHeight="0"
                                     VerticalContentAlignment="Top"/>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="6" Content="إنشاء رسالة"
                            Command="{Binding GenerateOutreachCommand}"
                            Style="{StaticResource AppButton}"
                            Background="#6D28D9"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
