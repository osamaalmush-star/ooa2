<UserControl x:Class="OAI.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Language="ar-SA"
             FontFamily="Segoe UI, Cairo, Tahoma"
             Background="{StaticResource BrushApp}">

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="إعداد أول تشغيل" Style="{StaticResource CaptionText}"/>
            <TextBlock Text="{Binding StepHint}" Style="{StaticResource SubtitleText}"/>
            <UniformGrid Columns="6" Margin="0,14,0,0">
                <Border CornerRadius="4" Padding="6" Margin="0,0,6,0" Background="#173056">
                    <TextBlock Text="1 ترحيب" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="4" Padding="6" Margin="0,0,6,0" Background="#1C2740">
                    <TextBlock Text="2 السيرة" Foreground="{StaticResource BrushText}" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="4" Padding="6" Margin="0,0,6,0" Background="#1C2740">
                    <TextBlock Text="3 البريد" Foreground="{StaticResource BrushText}" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="4" Padding="6" Margin="0,0,6,0" Background="#1C2740">
                    <TextBlock Text="4 المصادر" Foreground="{StaticResource BrushText}" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="4" Padding="6" Margin="0,0,6,0" Background="#1C2740">
                    <TextBlock Text="5 الجدول" Foreground="{StaticResource BrushText}" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="4" Padding="6" Background="#1C2740">
                    <TextBlock Text="6 جاهز" Foreground="{StaticResource BrushText}" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StepTitle}" Style="{StaticResource CaptionText}" FontSize="16"/>
                        <TextBlock Text="أدخل مفتاح Gemini من حسابك. لا يُوفَّر مفتاح داخل البرنامج." Style="{StaticResource SubtitleText}" Margin="0,6,0,14"/>
                        <TextBlock Text="مفتاح API" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="النموذج" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GeminiModelName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsResume, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="رفع السيرة" Style="{StaticResource CaptionText}" FontSize="16"/>
                                <TextBlock Text="{Binding ResumeFileName}" Style="{StaticResource SubtitleText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="رفع PDF أو Word" Command="{Binding UploadResumeCommand}" Style="{StaticResource AppButton}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="البريد" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="الجوال" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="العمر" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <TextBlock Text="الموقع" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="المسمى" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding TargetTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                                <TextBlock Text="الخبرة" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="التعليم" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Education, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="المهارات" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Skills, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="كلمات مفتاحية" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsEmail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="حساب البريد" Style="{StaticResource CaptionText}" FontSize="16" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="تفعيل المراقبة" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEmailEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Text="البريد" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IMAP" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ImapServer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="المنفذ" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="كلمة مرور التطبيق" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding AppPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSources, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="مصادر الوظائف" Style="{StaticResource CaptionText}" FontSize="16" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewPlatformName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            <TextBox Grid.Column="2" Text="{Binding NewTargetUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"/>
                            <Button Grid.Column="4" Content="إضافة" Command="{Binding AddSourceCommand}" Style="{StaticResource AppButton}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushInput}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PlatformName}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TargetUrl}" Foreground="{StaticResource BrushMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="حذف" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSchedule, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="جدول المراقبة" Style="{StaticResource CaptionText}" FontSize="16"/>
                        <TextBlock Text="الفترة بالدقائق (15 فأكثر)" Style="{StaticResource SubtitleText}" Margin="0,6,0,12"/>
                        <TextBox Text="{Binding MonitoringMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Width="160" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="جاهز" Style="{StaticResource CaptionText}" FontSize="18"/>
                        <TextBlock Text="السيرة محفوظة محلياً، والمصادر جاهزة للبحث عن الوظائف الشاغرة فقط." Style="{StaticResource SubtitleText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Error}" Foreground="#F87171" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="3" Content="{Binding PrimaryLabel}" Command="{Binding NextCommand}" Style="{StaticResource SuccessButton}"/>
        </Grid>
    </Grid>
</UserControl>
